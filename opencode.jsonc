{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "ideate": {
      "description": "Domain partner. Explores the why and what of an idea, then captures a use-case sketch before any technical discussion begins.",
      "mode": "primary",
      "color": "#7c9e7c"
    },
    "shape": {
      "description": "Tech lead. Challenges candidate approaches and drives a pro/contra discussion before any implementation begins.",
      "mode": "primary",
      "color": "#7c8fbe"
    },
    "craft": {
      "description": "Craftsman. Enriches the use-case skeleton one step at a time and waits for human review after each action.",
      "mode": "primary",
      "color": "#be9b7c"
    },
    "reflect": {
      "description": "Reflector. Disperses cycle learnings into project docs, runs a short retrospective, and closes the cycle.",
      "mode": "primary",
      "color": "#9b7cbe"
    }
  }
}
